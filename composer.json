{
    "name": "khakimjanovich/uz-phone",
    "description": "Framework-agnostic PHP library for strict Uzbek mobile phone parsing, normalization, validation, formatting, masking, and prefix metadata.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Khakimjanovich\\UzPhone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Khakimjanovich\\UzPhone\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
