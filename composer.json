{
    "name": "khakimjanovich/uz-phone",
    "description": "Framework-agnostic PHP library for strict Uzbek mobile phone parsing, normalization, validation, formatting, masking, and prefix metadata.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "uzbekistan",
        "uzbek",
        "uz-phone",
        "phone",
        "phone-number",
        "mobile",
        "validation",
        "normalization",
        "formatter",
        "masking",
        "e164",
        "998",
        "beeline",
        "ucell",
        "uzmobile",
        "mobiuz"
    ],
    "homepage": "https://github.com/khakimjanovich/uz-phone",
    "authors": [
        {
            "name": "khakimjanovich",
            "homepage": "https://github.com/khakimjanovich"
        }
    ],
    "support": {
        "issues": "https://github.com/khakimjanovich/uz-phone/issues",
        "source": "https://github.com/khakimjanovich/uz-phone"
    },
    "autoload": {
        "psr-4": {
            "Khakimjanovich\\UzPhone\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Khakimjanovich\\UzPhone\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "brick/phonenumber": "^0.8"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.21"
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:test": "pint --test",
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
